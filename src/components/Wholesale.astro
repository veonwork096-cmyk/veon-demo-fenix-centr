---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import FutureLink from "./FutureLink.astro";
import { phones, mailOrder, FUTURE_NOTE } from "../data/site";
const terms = [
  "Знижки й персональні бонуси при оптових замовленнях",
  "Швидка документація",
  "Безготівковий розрахунок з ПДВ і без",
  "Доставка по місту й області, розвантаження і занос",
];
---
<Section id="wholesale" rec="R-003" class="trade">
  <div class="container trade__grid">
    <div class="trade__lead">
      <h2>Оптовим клієнтам і бригадам</h2>
      <p class="lead">Забудовникам, магазинам будматеріалів і ремонтним бригадам. Надішліть список матеріалів — менеджер прорахує замовлення з оптовими умовами.</p>
      <div class="trade__act">
        <a class="btn btn--primary btn--lg" href={mailOrder}><Icon name="mail" /><span>Надіслати список на прорахунок</span></a>
        <a class="btn btn--ghost btn--lg" href={phones.sales1.href}><Icon name="phone" /><span class="tnum">{phones.sales1.label}</span></a>
      </div>
    </div>
    <div class="trade__terms">
      <h3 class="trade__h3">Умови для опту</h3>
      <ul>{terms.map((t) => <li>{t}</li>)}</ul>
      <FutureLink note={FUTURE_NOTE} class="future-link--inline trade__more">Детальніше про умови співпраці</FutureLink>
    </div>
  </div>
</Section>

<style>
  :global(.trade) { background: var(--color-accent); color: var(--color-text); padding-block: var(--section-gap); }
  .trade__grid { display: grid; gap: var(--s-5); }
  .trade__lead { display: grid; gap: var(--s-3); align-content: start; }
  .trade__lead .lead { max-width: 36rem; }
  .trade__act { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-2); padding-top: var(--s-1); }
  .trade__act .btn { flex: 1 1 auto; }
  :global(.trade) :global(.btn--primary:hover) { background: var(--color-surface); color: var(--color-text); border-color: var(--color-text); }

  .trade__h3 { margin-bottom: var(--s-2); }
  .trade__terms ul { border-top: 2px solid var(--color-text); }
  .trade__terms li { padding-block: var(--s-2); border-bottom: 1px solid var(--color-text); font-size: var(--fs-lead); font-weight: 500; line-height: 1.35; }
  :global(.trade__more) { margin-top: var(--s-2); font-weight: 600; text-decoration-color: var(--color-text); }
  :global(.trade) :global(.future-link__note) { background: var(--color-text); color: var(--color-on-dark); }

  @media (min-width: 1024px) {
    .trade__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--s-6); }
    .trade__act .btn { flex: 0 0 auto; }
  }
</style>
