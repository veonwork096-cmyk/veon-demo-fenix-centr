---
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { cities, FUTURE_NOTE } from "../data/site";
---
<Section id="about" rec="R-009" class="about section">
  <div class="container about__grid">
    <p class="about__big" aria-hidden="true">15+</p>
    <div class="about__body">
      <h2>Про компанію «Фенікс центр»</h2>
      <p class="lead"><strong>Більше 15 років</strong> на ринку будівельних матеріалів. Продаємо оптом і в роздріб: великим забудовникам, будівельним бригадам і приватним домовласникам. В асортименті — українські та європейські виробники.</p>
      <div class="about__net">
        <h3 class="about__h3">Мережа «Фенікс центр»</h3>
        <ul class="about__cities">{cities.map((c) => <li>{c}</li>)}</ul>
      </div>
      <FutureLink note={FUTURE_NOTE} class="future-link--inline about__more">Детальніше про компанію</FutureLink>
    </div>
  </div>
</Section>

<style>
  .about__grid { display: grid; gap: var(--s-3); }
  .about__big {
    font-family: var(--font-display); font-weight: 800; font-size: var(--fs-big); line-height: 0.85; letter-spacing: -0.05em;
    color: var(--color-text);
    padding-bottom: var(--s-2);
    border-bottom: var(--beam) solid var(--color-accent);
    justify-self: start;
  }
  .about__body { display: grid; gap: var(--s-3); align-content: start; }
  .about__body .lead { max-width: 38rem; }
  .about__h3 { font-family: var(--font-body); font-size: var(--fs-body); font-weight: 600; color: var(--color-muted); margin-bottom: var(--s-1); }
  .about__cities { display: grid; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h3); line-height: 1.3; }
  :global(.about__more) { justify-self: start; font-weight: 600; }
  @media (min-width: 1024px) {
    .about__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-6); align-items: start; }
  }
</style>
