---
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { address, FUTURE_NOTE } from "../data/site";
const pay = ["Готівкою на касі", "Безготівковий розрахунок з ПДВ і без", "Водієві при доставці", "Онлайн через Portmone"];
---
<Section id="delivery" rec="R-015" class="delivery section">
  <div class="container">
    <div class="section__head">
      <h2>Доставка і оплата</h2>
    </div>
    <div class="paths">
      <article class="path">
        <h3>Доставка на об'єкт</h3>
        <p>Адресна доставка по Львову та області. Вартість залежить від тоннажу й відстані, тарифи — за зонами.</p>
        <p class="muted">Розвантаження і вантажники — додаткова послуга.</p>
        <FutureLink note={FUTURE_NOTE} class="future-link--inline path__more">Тарифи доставки за зонами</FutureLink>
      </article>
      <article class="path">
        <h3>Самовивіз зі складу</h3>
        <p>Львів, {address.short}. Пн–пт 9:00–18:00, сб 9:00–14:00.</p>
        <p class="muted">Обсяг і час відвантаження погоджуйте з менеджером.</p>
        <a class="go path__more" href={address.map} target="_blank" rel="noopener"><span>Маршрут на карті</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a>
      </article>
    </div>
    <div class="pay">
      <h3 class="pay__title">Способи оплати</h3>
      <ul class="pay__list">{pay.map((p) => <li>{p}</li>)}</ul>
    </div>
  </div>
</Section>

<style>
  .paths { display: grid; gap: var(--s-4); }
  .path { display: grid; gap: var(--s-2); align-content: start; padding-top: var(--s-3); border-top: 2px solid var(--color-line); }
  .path p { max-width: 34rem; }
  .path__more { justify-self: start; font-weight: 600; }
  .pay { margin-top: var(--s-5); display: grid; gap: var(--s-2); }
  .pay__title { font-family: var(--font-body); font-size: var(--fs-body); font-weight: 600; color: var(--color-muted); }
  .pay__list { display: grid; gap: 0; background: var(--color-surface); border: var(--post) solid var(--color-line); }
  .pay__list li { padding: var(--s-2) var(--s-3); font-weight: 600; border-top: 1px solid var(--color-line-quiet); }
  .pay__list li:first-child { border-top: 0; }
  @media (min-width: 768px) {
    .paths { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); }
    .pay__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pay__list li { border-top: 0; border-left: 1px solid var(--color-line-quiet); }
    .pay__list li:nth-child(odd) { border-left: 0; }
    .pay__list li:nth-child(n+3) { border-top: 1px solid var(--color-line-quiet); }
  }
  @media (min-width: 1200px) {
    .pay__list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .pay__list li { border-left: 1px solid var(--color-line); border-top: 0 !important; }
    .pay__list li:first-child { border-left: 0; }
    .pay__list li:nth-child(odd):not(:first-child) { border-left: 1px solid var(--color-line); }
  }
</style>
