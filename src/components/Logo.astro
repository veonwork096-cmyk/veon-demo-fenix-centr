---
// Typographic logo: a drawn phoenix mark (three rising feathers in the brand's warm tones) + wordmark.
// No client logo file was supplied; this mark is a stand-in drawn for the demo, not a copy of anyone's logo.
interface Props { class?: string; }
const { class: cls } = Astro.props;
---
<a class:list={["logo", cls]} href="#top" aria-label="Фенікс центр, на початок сторінки">
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <path class="logo__f1" d="M20 38C9 31 4 20 6 5c6 9 11 18 14 33z" />
    <path class="logo__f2" d="M20 38c11-7 16-18 14-33-6 9-11 18-14 33z" />
    <path class="logo__f3" d="M20 31c-5-8-5-18 0-29 5 11 5 21 0 29z" />
  </svg>
  <span class="logo__word">Фенікс <span>центр</span></span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; min-height: 44px; color: var(--color-text); text-decoration: none; flex: none; }
  .logo__mark { width: 34px; height: 34px; }
  .logo__f1 { fill: var(--color-accent); }
  .logo__f2 { fill: var(--color-accent-ink); }
  .logo__f3 { fill: var(--color-text); }
  .logo__word { font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; letter-spacing: -0.03em; line-height: 1; white-space: nowrap; }
  .logo__word span { font-weight: 500; }
</style>
