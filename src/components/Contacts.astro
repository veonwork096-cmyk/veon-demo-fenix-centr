---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { phones, emails, mailOrder, mailAccounting, address, instagram } from "../data/site";
---
<Section id="contacts" rec="R-001,R-011,S-R001" class="contacts">
  <div class="container contacts__grid">
    <div class="contacts__sales">
      <h2>Контакти</h2>
      <h3 class="contacts__h3">Відділ продажів</h3>
      <ul class="contacts__phones">
        <li><a class="contacts__phone tnum" href={phones.sales1.href}>{phones.sales1.label}</a></li>
        <li><a class="contacts__phone tnum" href={phones.sales2.href}>{phones.sales2.label}</a></li>
      </ul>
      <a class="go contacts__mail" href={mailOrder}><Icon name="mail" /><span>{emails.sales}</span></a>
    </div>

    <div class="contacts__side">
      <div class="contacts__block">
        <h3 class="contacts__h3">Склад і офіс</h3>
        <p class="contacts__big">{address.full}</p>
        <a class="go" href={address.map} target="_blank" rel="noopener"><Icon name="pin" /><span>Відкрити на карті</span></a>
      </div>
      <div class="contacts__block">
        <h3 class="contacts__h3">Графік роботи</h3>
        <p class="contacts__status" data-status hidden></p>
        <p>Пн–пт 9:00–18:00<br />Сб 9:00–14:00, нд вихідний</p>
        <p class="small contacts__note" data-closed-note hidden>Поза графіком <a class="link" href={mailOrder}>надішліть список на e-mail</a> — менеджер відповість у робочий час</p>
      </div>
      <div class="contacts__block contacts__minor">
        <h3 class="contacts__h3">Бухгалтерія і закупівлі</h3>
        <p><a class="link tnum" href={phones.accounting.href}>{phones.accounting.label}</a></p>
        <p><a class="link" href={mailAccounting}>{emails.accounting}</a></p>
      </div>
      <div class="contacts__block">
        <a class="go" href={instagram} target="_blank" rel="noopener"><span>Сторінка мережі в Instagram</span></a>
      </div>
    </div>
  </div>
</Section>

<style>
  :global(.contacts) { background: var(--color-inverse-bg); color: var(--color-inverse-text); padding-block: var(--section-gap); --color-focus: var(--color-accent); }
  .contacts__grid { display: grid; gap: var(--s-5); }
  .contacts__sales { display: grid; gap: var(--s-2); align-content: start; justify-items: start; }
  .contacts__sales h2 { margin-bottom: var(--s-3); text-wrap: balance; }
  .contacts__h3 { font-family: var(--font-body); font-size: var(--fs-body); font-weight: 600; color: var(--color-inverse-text); opacity: 0.78; }
  .contacts__phones { display: grid; gap: var(--s-1); }
  .contacts__phone {
    display: inline-block; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-phone); line-height: 1.1; letter-spacing: -0.02em;
    color: var(--color-inverse-text); text-decoration: none; white-space: nowrap;
    border-bottom: 4px solid var(--color-accent); padding-bottom: 0.05em;
    transition: color var(--dur-short) var(--ease-out);
  }
  .contacts__phone:hover { color: var(--color-accent); }
  .contacts__mail span { overflow-wrap: anywhere; }
  :global(.contacts) :global(.go:hover) { color: var(--color-accent); }
  .contacts__side { display: grid; gap: var(--s-4); align-content: start; }
  .contacts__block { display: grid; gap: var(--s-1); justify-items: start; }
  .contacts__big { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-h3); line-height: 1.2; }
  .contacts__status { font-weight: 600; color: var(--color-accent); }
  .contacts__note { opacity: 0.85; }
  :global(.contacts) :global(.link:hover) { color: var(--color-accent); }
  .contacts__minor { font-size: var(--fs-small); padding-top: var(--s-3); border-top: 1px solid var(--color-muted); }
  .contacts__minor .contacts__h3 { font-size: var(--fs-small); }
  @media (min-width: 1024px) {
    .contacts__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-6); }
  }
</style>
